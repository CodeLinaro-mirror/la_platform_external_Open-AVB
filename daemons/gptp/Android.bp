// ====================================================================================
// Android.bp and Prebuilt Configuration for gPTP (Generalized Precision Time Protocol)
// ------------------------------------------------------------------------------------

soong_config_module_type {
    name: "gptp_cfg_prebuilt",
    module_type: "prebuilt_etc",
    config_namespace: "qtigptp",
    bool_variables: [
        "gen5gvm",
        "gen4gvm",
        "cdccomm",
    ],
    properties: ["src"],
}

gptp_cfg_prebuilt {
    name: "gptp_cfg",
    filename: "gptp_cfg.ini",
    vendor: true,
    installable: true,

    src: "etc/gptp_cfg.ini",

    soong_config_variables: {
        gen5gvm: {
            src: "etc/gptp_cfg_gvm.ini",
        },
        gen4gvm: {
            src: "etc/gptp_cfg.ini",
        },
        cdccomm: {
            src: "etc/gptp_cfg_au.ini",
        },
    },
}

soong_config_module_type {
    name: "gptp_rc_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtigptp",
    bool_variables: [
        "gen5gvm",
        "cdccomm",
    ],
    properties: ["init_rc"],
}

gptp_rc_cc_defaults {
    name: "gptp_daemon_rc",
    vendor: true,
    installable: true,

    soong_config_variables: {
        gen5gvm: {
            init_rc: ["etc/gptp_daemon.rc"],
        },
        cdccomm: {
            init_rc: ["etc/gptp_daemon.rc"],
        },
    },
}

cc_binary {
    name: "qgptp",

    defaults: ["gptp_daemon_rc"],

    cflags: [
        "-DWITHOUT_IFADDRS",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-DPTP_SW_QTIMER=1",
        "-DSYSTEMD",
        "-DGPTP_CAR_POWER_POLICY",
    ],

    local_include_dirs: ["inc"],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
    ],

    srcs: [
        "src/daemon_cl.cpp",
        "src/ptp_message.cpp",
        "src/avbts_osnet.cpp",
        "src/ap_message.cpp",
        "src/common_port.cpp",
        "src/ether_port.cpp",
        "src/ieee1588clock.cpp",
        "src/gptp_cfg.cpp",
        "src/gptp_log.cpp",
        "src/ini.c",
        "src/linux_hal_common.cpp",
        "src/linux_hal_persist_file.cpp",
        "src/platform.cpp",
        "src/linux_hal_generic.cpp",
        "src/linux_hal_generic_adj.cpp",
        "src/qgptp_rmgr.cpp",
    ],

    rtti: true,
    vendor: true,

    required: [
        "gptp_cfg",
    ],
}